export PATH="$HOME/.cargo/bin/:$PATH"
export EDITOR="nvim"

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="lambda"
plugins=(git)
source $ZSH/oh-my-zsh.sh

alias ls='lsd'
alias l='ls -la'
alias cl='reset && l'
alias nv='nvim'
alias py='python'
alias fastfetch='sh $HOME/.config/fastfetch/pokemon.sh'
alias gith='echo "git remote set-url origin git@github.com:<user>/<repo>.git" && echo "git remote -v"'

fastfetch

